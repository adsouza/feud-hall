{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "isolatedModules": true
  },
  "include": [
    "src/**/*.ts",
    "test/browser/**/*.ts",
    "playwright.config.ts",
    "vite.config.ts"
  ]
}
