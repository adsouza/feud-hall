{
  "name": "feud-hall-web",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint src test/browser src-tauri/src/zoom.js src-tauri/src/diagnostics.js vite.config.ts playwright.config.ts",
    "format": "prettier --ignore-path ../.gitignore --write .",
    "format:check": "prettier --ignore-path ../.gitignore --check .",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.svelte.json",
    "test:browser": "playwright test",
    "desktop:assets": "tauri icon ../assets/branding/feud-hall-icon.svg && bun run --bun build --outDir dist",
    "desktop:dev": "tauri dev --no-dev-server",
    "desktop:build": "tauri build"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "26.6.6",
    "@types/three": "0.187.0",
    "d3-geo": "3.1.2",
    "fast-check": "4.10.2",
    "oxlint": "1.93.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "topojson-client": "3.1.0",
    "typescript": "6.0.3",
    "vite": "8.3.7",
    "world-atlas": "2.0.2"
  },
  "dependencies": {
    "@fontsource/noto-sans-jp": "5.3.1",
    "@tauri-apps/api": "2.12.4",
    "three": "0.187.0"
  }
}
