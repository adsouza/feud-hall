{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Feud Hall",
  "version": "0.2.0",
  "identifier": "io.github.adsouza.FeudHall",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "bun run desktop:assets",
    "beforeDevCommand": "bun run desktop:assets"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "deb"],
    "category": "SimulationGame",
    "shortDescription": "Online food hall management game",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libdbus-1-3"]
      }
    }
  }
}
